<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<PropertyGroup>
		<PackageRoot>$(MSBuildProjectDirectory)\..\GUI_LocalHttpDaemon_Package\</PackageRoot>
		<!-- Visual Studio の最新状態判定後も配布物の生成を実行する。 -->
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	</PropertyGroup>

	<Target Name="CreateReleasePackage" AfterTargets="Build"
					Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SkipReleasePackage)' != 'true'">
		<PropertyGroup>
			<PackagePublishDir>$(PackageRoot)$(RuntimeIdentifier)\</PackagePublishDir>
			<PackageStagingDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)package\</PackageStagingDir>
			<PackageZipPath>$(PackageRoot)$(AssemblyName)-$(RuntimeIdentifier).zip</PackageZipPath>
		</PropertyGroup>

		<!-- ビルド済みの成果物を発行し、Build の再帰実行を防ぐ。 -->
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish"
						 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);NoBuild=true;BuildProjectReferences=false;SkipReleasePackage=true;PublishDir=$(PackagePublishDir)" />
		<MakeDir Directories="$(PackageStagingDir)" />
		<Copy SourceFiles="$(PackagePublishDir)$(AssemblyName).exe" DestinationFolder="$(PackageStagingDir)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\..\Documents\GUI版アプリケーション仕様.md"
					DestinationFiles="$(PackagePublishDir)README.md" />
		<Copy SourceFiles="$(PackagePublishDir)README.md" DestinationFolder="$(PackageStagingDir)" />
		<ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
		<Message Importance="high" Text="単独実行用 EXE: $(PackagePublishDir)$(AssemblyName).exe" />
		<Message Importance="high" Text="配布用 ZIP: $(PackageZipPath)" />
	</Target>

</Project>
